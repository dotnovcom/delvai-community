# App
APP_NAME=得律AI
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
# ENCRYPTION_KEY=  # 可选，专用于后台敏感配置 AES-GCM 加密
ALLOW_PAYMENT_MOCK=false
ALLOW_DEV_PAYMENT_CONFIRM=false
ALLOW_PUBLIC_UPLOADS=false
ALLOW_ESIGN_CALLBACK_WITHOUT_SECRET=true
# ESIGN_CALLBACK_SECRET=

# Database
DATABASE_URL=postgresql://falitong:falitong@localhost:5432/falitong

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_ENABLED=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Aliyun (placeholder)
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# AI APIs (placeholder)
# FARUI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_VL_API_KEY=
# AI_MOCK_MODE=true
# 生产环境须为 false；本地 Docker 见 docker-compose.local.yml

# WeChat Mini Program (placeholder)
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# Admin bootstrap (creates super_admin on startup)
# ADMIN_BOOTSTRAP_PHONE=13800000000
# ADMIN_BOOTSTRAP_PASSWORD=change-me456

# uni-push 2.0
